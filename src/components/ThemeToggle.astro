---
// Theme toggle. Default theme is dark (by contract); choice persists in
// localStorage and is applied pre-paint by the inline script in Base.astro.
---

<button id="theme-toggle" class="theme-toggle" type="button">light mode</button>

<style>
  .theme-toggle {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: lowercase;
    background: transparent;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3xs) var(--space-xs);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 85%, var(--color-bg));
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const label = () => {
    if (btn) btn.textContent = root.dataset.theme === 'dark' ? 'light mode' : 'dark mode';
  };
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    label();
  });
  label();
</script>
