---
// One project on the timeline spine: mono period rail + node left, body
// right. Used for both active entries and the folded archive.
const { project, Content } = Astro.props;
const primary = project.data.links[0];
---

<article class="tl-entry">
  <div class="tl-rail">
    <span class="tl-date mono-label">{project.data.period}</span>
    <span
      class:list={['tl-node', { 'tl-node-muted': project.data.archived }]}
      aria-hidden="true"
    />
  </div>
  <div class="tl-body">
    <span class="tl-date-inline mono-label">{project.data.period}</span>
    <h2 class="tl-title">
      {primary ? (
        <a class="tl-title-link" href={primary.url}>
          {project.data.title} <span class="tl-ext" aria-hidden="true">↗</span>
        </a>
      ) : (
        project.data.title
      )}
    </h2>
    <div class="tl-desc prose">
      <Content />
    </div>
    {project.data.milestones.map((m) => (
      <p class="tl-milestone">
        <span class="mono-label">{m.period}</span>
        <span class="tl-milestone-title">{m.title}</span>
      </p>
    ))}
    {project.data.links.length > 0 && (
      <p class="tl-links mono-label">
        {project.data.links.map((l, i) => (
          <>
            {i > 0 && ' · '}
            <a class="tl-link" href={l.url}>
              {l.label} ↗
            </a>
          </>
        ))}
      </p>
    )}
    {project.data.status && <p class="tl-status mono-label">status → {project.data.status}</p>}
  </div>
</article>

<style>
  .tl-entry {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-m);
  }
  .tl-rail {
    position: relative;
    text-align: right;
    padding-right: var(--space-m);
    border-right: 1px solid var(--color-border);
  }
  .tl-date {
    display: block;
    padding-top: var(--space-3xs);
  }
  .tl-node {
    position: absolute;
    right: calc(-1 * var(--space-3xs) - 1px);
    top: var(--space-2xs);
    width: var(--space-2xs);
    height: var(--space-2xs);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
  }
  .tl-node-muted {
    border-color: var(--color-muted);
  }
  .tl-title {
    font-size: var(--step-1);
    margin: 0 0 var(--space-2xs);
  }
  .tl-title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tl-title-link:hover {
    color: var(--color-accent);
  }
  .tl-ext {
    font-size: 0.7em;
    color: var(--color-muted);
  }
  .tl-title-link:hover .tl-ext {
    color: var(--color-accent);
  }
  .tl-desc {
    color: var(--color-text);
    font-size: var(--step-0);
  }
  .tl-desc :global(p) {
    margin: 0 0 var(--space-2xs);
  }
  .tl-milestone {
    margin: var(--space-2xs) 0 0;
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
  }
  .tl-milestone-title {
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  .tl-links {
    margin: var(--space-2xs) 0 0;
  }
  .tl-link {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tl-link:hover {
    color: var(--color-accent);
  }
  .tl-status {
    margin: var(--space-2xs) 0 0;
    color: var(--color-accent);
  }
  /* Period shown inside the body only on the slim mobile spine. */
  .tl-date-inline {
    display: none;
  }
  @media (max-width: 40rem) {
    /* Slim spine: the rail narrows to just the line + node; the period
       moves above the title so signature move ③ survives on phones. */
    .tl-entry {
      grid-template-columns: var(--space-2xs) 1fr;
      gap: var(--space-s);
    }
    .tl-rail {
      padding-right: 0;
    }
    .tl-date {
      display: none;
    }
    .tl-date-inline {
      display: block;
      margin-bottom: var(--space-3xs);
    }
  }
</style>
