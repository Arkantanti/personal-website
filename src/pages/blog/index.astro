---
// Blog index — chronological, so it rides the timeline spine (signature
// move ③): mono date rail left, titles right.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
    .toLowerCase();
---

<Base title="Blog — Jakub Pieczonka" description="Writing by Jakub Pieczonka.">
  <h1 class="page-title">blog</h1>

  {
    posts.length === 0 ? (
      <p class="muted">First post lands soon.</p>
    ) : (
      <div class="timeline">
        {posts.map((post) => (
          <article class="tl-entry">
            <div class="tl-rail">
              <span class="tl-date mono-label">{fmt(post.data.date)}</span>
              <span class="tl-node" aria-hidden="true" />
            </div>
            <div class="tl-body">
              <span class="tl-date-inline mono-label">{fmt(post.data.date)}</span>
              <h2 class="tl-title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="tl-desc">{post.data.description}</p>
              {post.data.placeholder && <p class="mono-label ph">[placeholder — never ships]</p>}
            </div>
          </article>
        ))}
      </div>
    )
  }
</Base>

<style>
  .page-title {
    font-size: var(--step-4);
    margin: var(--space-l) 0 var(--space-xl);
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .tl-entry {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-m);
  }
  .tl-rail {
    position: relative;
    text-align: right;
    padding-right: var(--space-m);
    border-right: 1px solid var(--color-border);
  }
  .tl-date {
    display: block;
    padding-top: var(--space-3xs);
  }
  .tl-node {
    position: absolute;
    right: calc(-1 * var(--space-3xs) - 1px);
    top: var(--space-2xs);
    width: var(--space-2xs);
    height: var(--space-2xs);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
  }
  .tl-title {
    font-size: var(--step-1);
    margin: 0 0 var(--space-2xs);
  }
  .tl-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tl-title a:hover {
    color: var(--color-accent);
  }
  .tl-desc {
    max-width: var(--measure);
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }
  .ph {
    margin: var(--space-2xs) 0 0;
    opacity: 0.55;
  }
  /* Date shown inside the body only on the slim mobile spine. */
  .tl-date-inline {
    display: none;
  }
  @media (max-width: 40rem) {
    /* Slim spine: the rail narrows to just the line + node; the date
       moves above the title so signature move ③ survives on phones. */
    .tl-entry {
      grid-template-columns: var(--space-2xs) 1fr;
      gap: var(--space-s);
    }
    .tl-rail {
      padding-right: 0;
    }
    .tl-date {
      display: none;
    }
    .tl-date-inline {
      display: block;
      margin-bottom: var(--space-3xs);
    }
  }
</style>
