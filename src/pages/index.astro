---
// HOME — the bento of doors (signature move ①). No nav bar: the tiles ARE
// the navigation. Name + small bio/contact above the board (owner request).
// Bio text is a PLACEHOLDER — replaced before launch. The blog tile
// preview is LIVE (latest post); other previews go live as pages get built.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const projects = (await getCollection('projects', ({ data }) => !data.archived)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const nowEntries = (await getCollection('now')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const currentNow = nowEntries[0];
const nowDate = currentNow?.data.date
  .toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  .toLowerCase();
---

<Base title="Jakub Pieczonka" showNav={false}>
  <section class="hero">
    <h1 class="hero-name">Jakub Pieczonka</h1>
  </section>

  <nav class="tiles" aria-label="Site">
    <a class="tile tile-wide" href="/projects/">
      <span class="tile-name">projects</span>
      <span class="tile-meta mono-label">{projects.length} ongoing →</span>
    </a>
    <a class="tile" href="/now/">
      <span class="tile-name">/now</span>
      <span class="tile-meta mono-label">{currentNow ? `${nowDate} →` : 'coming soon →'}</span>
    </a>
    <a class="tile" href="/blog/">
      <span class="tile-name">blog</span>
      <span class="tile-meta mono-label">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} →
      </span>
    </a>
    <a class="tile" href="/resume.pdf">
      <span class="tile-name">resume</span>
      <span class="tile-meta mono-label">pdf, one page →</span>
    </a>
    <a class="tile" href="/contact/">
      <span class="tile-name">contact</span>
      <span class="tile-meta mono-label">email · github →</span>
    </a>
  </nav>

  <section class="about">
    <h2 class="about-title">Who do I do?</h2>
    <p class="about-bio">
      I dabble in maths and CS, currently doing a bachelor's in the latter. Presently <a href="/projects">untangling the knots</a> of AI research.
      I like learning things and I like trying things. This site is a shadow of what <a href="/now">I'm doing</a> and <a href="/blog">what I'm thinking</a>.
    </p>
    <p class="about-bio">
      I used to compete in olympiad mathematics, and I still share what I know at preparation camps with prodigies who are still
      competing. For studies I moved to computer science — I left Poland for the Netherlands, and I'm now leaving the Netherlands for the UK.
    </p>
    <p class="about-bio">
      When I'm taking a break from science I'm probably <a href="https://www.goodreads.com/user/show/155463456-kuba-pieczonka" target="_blank" rel="noopener noreferrer">reading books</a>,
      <a href="https://letterboxd.com/Arkantanti/" target="_blank" rel="noopener noreferrer">watching movies</a>, or playing games — plus a few other hobbies that won't fit in this paragraph.
    </p>
  </section>
</Base>

<style>
  .hero {
    margin-top: var(--space-l);
    margin-bottom: var(--space-2xl);
  }
  .hero-name {
    font-size: var(--step-5);
    margin: 0;
  }
  .about {
    margin-top: var(--space-2xl);
  }
  .about-title {
    font-size: var(--step-2);
    margin: 0 0 var(--space-s);
  }
  .about-bio {
    max-width: var(--measure);
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-0);
    color: var(--color-muted);
  }
  .ph-mark {
    opacity: 0.55;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-s);
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    justify-content: space-between;
    min-height: 11rem;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-m);
    box-shadow: var(--shadow-sm);
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .tile:hover {
    background: var(--color-surface-2);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .tile:hover .tile-meta {
    color: var(--color-accent);
  }
  .tile-wide {
    grid-column: span 2;
  }
  .tile-name {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--step-3);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
  }
  .tile-preview {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }
  .tile-meta {
    transition: color var(--dur-fast) var(--ease-out);
  }
  @media (max-width: 40rem) {
    .tile-wide {
      grid-column: span 1;
    }
    /* One column of doors: compress to content height so Home isn't a
       long corridor of empty tiles. */
    .tile {
      min-height: 0;
      gap: var(--space-s);
    }
    .hero-name {
      font-size: var(--step-4);
    }
  }
</style>
